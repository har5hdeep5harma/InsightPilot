INSIGHTPILOT_ENV=development
INSIGHTPILOT_DATABASE_URL=sqlite:///./data/insightpilot.sqlite
INSIGHTPILOT_UPLOAD_DIR=../sample-data/uploads
INSIGHTPILOT_EXPORT_DIR=../sample-data/exports
INSIGHTPILOT_SAMPLE_DATASET_PATH=../sample-data/saas_growth_sample.csv
INSIGHTPILOT_MAX_UPLOAD_MB=25
INSIGHTPILOT_CORS_ORIGINS=http://localhost:3000

# Optional AI narrative polishing. The app works without these values.
ENABLE_AI_NARRATIVE=false
AI_NARRATIVE_API_KEY=
AI_NARRATIVE_BASE_URL=https://api.openai.com/v1/chat/completions
AI_NARRATIVE_MODEL=gpt-4o-mini
